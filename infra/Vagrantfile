# -*- mode: ruby -*-
# vi: set ft=ruby :
 
Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "sysops-test01.local"
  config.vm.network "private_network", ip: "192.168.56.11"
  config.vm.network "forwarded_port", guest: 80, host: 8080, auto_correct: true
  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 2
    vb.memory = 2048
    vb.gui = false
  end
  config.vm.provision "ansible" do |ansible|
    ansible.config_file = File.expand_path("../ansible/ansible.cfg", __dir__)
    ansible.playbook = File.expand_path("../ansible/playbooks/apps/sysops-poc.yaml", __dir__)
    ansible.extra_vars = {
      api_replicas: "1",
      statics_replicas: 1
    }
    # ansible.verbose = "v"
  end
end
